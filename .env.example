# Rhymma website environment variables
# Copy this file to `.env` and adjust as needed.
# NOTE: These are all OPTIONAL. The app runs with sensible defaults if unset.
# Do NOT put secrets, passwords, or API keys in this frontend project.

# Dev/preview server port (default: 5173)
PORT=5173

# Base public path the app is served from (default: "/").
# Use "/" for a root domain (e.g. rhymma.com).
# Use "/subpath/" if hosting under a sub-path (e.g. GitHub Pages project sites).
BASE_PATH=/
